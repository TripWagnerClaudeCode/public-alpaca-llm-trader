# Copy to .env and fill in. Never commit .env.
# Profile A: Alpaca PAPER account
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Profile B (small-cap): a second Alpaca PAPER account
ALPACA_B_API_KEY=
ALPACA_B_SECRET_KEY=
# Required for SEC filing lookups (SEC fair-access rules): "Your Name your@email"
SEC_USER_AGENT=
# Only needed with agents.backend: api
ANTHROPIC_API_KEY=
# Optional: required only to trade real money
ALLOW_LIVE_TRADING=no
# Optional data keys
FMP_API_KEY=
FRED_API_KEY=

# Email summaries (Gmail app password from myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
